diff --git a/tests/capability_test.c b/tests/capability_test.c
new file mode 100644
index 0000000..ac99945
--- /dev/null
+++ b/tests/capability_test.c
@@ -0,0 +1,202 @@
+/* Capability truthfulness test: no VPU hardware or decode is required. */
+#include <stdio.h>
+#include <string.h>
+#include <dlfcn.h>
+
+#include <va/va.h>
+#include <va/va_backend.h>
+
+typedef VAStatus (*driver_init_fn)(VADriverContextP);
+
+static const VAProfile supported[] = {
+	VAProfileH264ConstrainedBaseline,
+	VAProfileH264Main,
+	VAProfileH264High,
+	VAProfileHEVCMain,
+};
+
+static const VAProfile unsupported[] = {
+	VAProfileHEVCMain10,
+	VAProfileAV1Profile0,
+	VAProfileNone,
+};
+
+static int checks;
+static int failures;
+
+static void expect(int condition, const char *what, int actual)
+{
+	checks++;
+	if (!condition) {
+		fprintf(stderr, "FAIL: %s (actual=%d)\n", what, actual);
+		failures++;
+	}
+}
+
+static int supported_index(VAProfile profile)
+{
+	unsigned int i;
+
+	for (i = 0; i < sizeof(supported) / sizeof(supported[0]); i++)
+		if (supported[i] == profile)
+			return (int)i;
+	return -1;
+}
+
+static void check_profiles(VADriverContextP ctx)
+{
+	VAProfile profiles[16];
+	int seen[4] = {0};
+	int np = 0;
+	int i;
+	VAStatus st = ctx->vtable->vaQueryConfigProfiles(ctx, profiles, &np);
+
+	expect(st == VA_STATUS_SUCCESS, "QueryConfigProfiles status", st);
+	expect(np == 4, "exact advertised profile count", np);
+	if (st != VA_STATUS_SUCCESS || np < 0 || np > 16)
+		return;
+	for (i = 0; i < np; i++) {
+		int index = supported_index(profiles[i]);
+		expect(index >= 0, "advertised profile is supported decode", profiles[i]);
+		if (index >= 0) {
+			expect(!seen[index], "profile is not duplicated", profiles[i]);
+			seen[index] = 1;
+		}
+	}
+	for (i = 0; i < 4; i++)
+		expect(seen[i], "required decode profile is advertised", supported[i]);
+}
+
+static void check_entrypoints(VADriverContextP ctx)
+{
+	VAEntrypoint entries[8];
+	unsigned int i;
+	int ne;
+	VAStatus st;
+
+	for (i = 0; i < sizeof(supported) / sizeof(supported[0]); i++) {
+		ne = 0;
+		memset(entries, 0, sizeof(entries));
+		st = ctx->vtable->vaQueryConfigEntrypoints(ctx, supported[i], entries, &ne);
+		expect(st == VA_STATUS_SUCCESS, "supported profile entrypoint query", st);
+		expect(ne == 1, "supported profile has exactly one entrypoint", ne);
+		expect(ne == 1 && entries[0] == VAEntrypointVLD,
+		       "supported profile is VLD-only", ne == 1 ? (int)entries[0] : -1);
+	}
+	for (i = 0; i < sizeof(unsupported) / sizeof(unsupported[0]); i++) {
+		ne = -1;
+		st = ctx->vtable->vaQueryConfigEntrypoints(ctx, unsupported[i], entries, &ne);
+		expect(st == VA_STATUS_ERROR_UNSUPPORTED_PROFILE,
+		       "unsupported profile entrypoint query is rejected", st);
+		expect(ne == -1, "rejected entrypoint query emits no count", ne);
+	}
+}
+
+static void expect_create_rejected(VADriverContextP ctx, VAProfile profile,
+                                   VAEntrypoint entrypoint, VAStatus expected)
+{
+	VAConfigID config = (VAConfigID)0x7fffffff;
+	VAStatus st = ctx->vtable->vaCreateConfig(ctx, profile, entrypoint,
+	                                          NULL, 0, &config);
+	expect(st == expected, "CreateConfig rejects unsupported combination", st);
+	expect(config == (VAConfigID)0x7fffffff,
+	       "rejected CreateConfig leaves output untouched", config);
+}
+
+static void check_create_config(VADriverContextP ctx)
+{
+	unsigned int i;
+
+	for (i = 0; i < sizeof(supported) / sizeof(supported[0]); i++) {
+		VAConfigID config = (VAConfigID)0x7fffffff;
+		VAProfile actual_profile = VAProfileNone;
+		VAEntrypoint actual_entrypoint = (VAEntrypoint)0;
+		VAStatus st = ctx->vtable->vaCreateConfig(ctx, supported[i], VAEntrypointVLD,
+		                                          NULL, 0, &config);
+		expect(st == VA_STATUS_SUCCESS, "CreateConfig accepts real VLD capability", st);
+		expect(config != (VAConfigID)0x7fffffff, "valid config ID returned", config);
+		if (st == VA_STATUS_SUCCESS) {
+			st = ctx->vtable->vaQueryConfigAttributes(ctx, config, &actual_profile,
+			                                          &actual_entrypoint, NULL, NULL);
+			expect(st == VA_STATUS_SUCCESS, "QueryConfigAttributes on valid config", st);
+			expect(actual_profile == supported[i], "valid config retains profile", actual_profile);
+			expect(actual_entrypoint == VAEntrypointVLD, "valid config retains VLD", actual_entrypoint);
+			ctx->vtable->vaDestroyConfig(ctx, config);
+		}
+		expect_create_rejected(ctx, supported[i], VAEntrypointEncSlice,
+		                       VA_STATUS_ERROR_UNSUPPORTED_ENTRYPOINT);
+	}
+	for (i = 0; i < sizeof(unsupported) / sizeof(unsupported[0]); i++) {
+		expect_create_rejected(ctx, unsupported[i], VAEntrypointVLD,
+		                       VA_STATUS_ERROR_UNSUPPORTED_PROFILE);
+		expect_create_rejected(ctx, unsupported[i], VAEntrypointEncSlice,
+		                       VA_STATUS_ERROR_UNSUPPORTED_PROFILE);
+	}
+}
+
+static void check_config_attributes(VADriverContextP ctx)
+{
+	VAConfigAttrib attrib;
+	VAStatus st;
+	unsigned int i;
+
+	attrib.type = VAConfigAttribRTFormat;
+	attrib.value = 0;
+	st = ctx->vtable->vaGetConfigAttributes(ctx, VAProfileHEVCMain, VAEntrypointVLD,
+	                                        &attrib, 1);
+	expect(st == VA_STATUS_SUCCESS, "GetConfigAttributes accepts real VLD capability", st);
+	expect(attrib.value == VA_RT_FORMAT_YUV420, "real VLD capability keeps YUV420", attrib.value);
+
+	attrib.value = 0;
+	st = ctx->vtable->vaGetConfigAttributes(ctx, VAProfileHEVCMain, VAEntrypointEncSlice,
+	                                        &attrib, 1);
+	expect(st == VA_STATUS_ERROR_UNSUPPORTED_ENTRYPOINT,
+	       "GetConfigAttributes rejects encode", st);
+	for (i = 0; i < sizeof(unsupported) / sizeof(unsupported[0]); i++) {
+		st = ctx->vtable->vaGetConfigAttributes(ctx, unsupported[i], VAEntrypointVLD,
+		                                        &attrib, 1);
+		expect(st == VA_STATUS_ERROR_UNSUPPORTED_PROFILE,
+		       "GetConfigAttributes rejects unsupported profile", st);
+	}
+}
+
+int main(int argc, char **argv)
+{
+	const char *path = argc > 1 ? argv[1] : "./loongvpu_drv_video.so";
+	void *handle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+	driver_init_fn init;
+	struct VADriverContext ctx;
+	VAStatus st;
+
+	if (!handle) {
+		fprintf(stderr, "dlopen failed: %s\n", dlerror());
+		return 1;
+	}
+	init = (driver_init_fn)dlsym(handle, "__vaDriverInit_1_15");
+	if (!init) {
+		fprintf(stderr, "dlsym(__vaDriverInit_1_15) failed: %s\n", dlerror());
+		dlclose(handle);
+		return 1;
+	}
+	memset(&ctx, 0, sizeof(ctx));
+	st = init(&ctx);
+	if (st != VA_STATUS_SUCCESS || !ctx.vtable || !ctx.pDriverData) {
+		fprintf(stderr, "driver init failed: %d\n", st);
+		dlclose(handle);
+		return 1;
+	}
+
+	check_profiles(&ctx);
+	check_entrypoints(&ctx);
+	check_create_config(&ctx);
+	check_config_attributes(&ctx);
+
+	ctx.vtable->vaTerminate(&ctx);
+	dlclose(handle);
+	if (failures) {
+		fprintf(stderr, "capability_test FAILED: %d/%d checks failed\n", failures, checks);
+		return 1;
+	}
+	printf("capability_test PASSED (%d checks; H264/HEVC Main VLD only)\n", checks);
+	return 0;
+}
