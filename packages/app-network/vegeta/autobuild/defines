PKGNAME=vegeta
PKGSEC=net
PKGDES="HTTP load testing tool and library"
PKGDEP="@AB_AUTO_SO_DEPS@"
BUILDDEP="go"
PKGHOMEPAGE="https://github.com/tsenart/vegeta"

ABTYPE=gomod
GO_PACKAGES=(".")
# main.go 里声明了 var ( Version, Commit, Date string )，
# 不注入时 `vegeta -version` 的 Version/Commit 都是空的。
GO_LDFLAGS=("-s -w" "-X main.Version=$PKGVER" "-X main.Commit=unknown" "-X main.Date=unknown")
ABSPLITDBG=0
ABSTRIP=0
