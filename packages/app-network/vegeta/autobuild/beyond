#!/bin/bash
# 补齐 man 页：rust/go 模板只装二进制，上游附带的 man 源文件不会被安装。
# 全量审计发现 54 个有 CLI 的包里 45 个零 man 页（详见 scripts/audit-manpages.sh）。
# 这里扫描上游常见的 man 位置，找到就装到标准路径。
_shopt=$(shopt -p nullglob || true)
shopt -s nullglob
for src in "$SRCDIR"/doc/*.1 "$SRCDIR"/docs/*.1 "$SRCDIR"/man/*.1 \
           "$SRCDIR"/gen/*.1 "$SRCDIR"/*.1 "$SRCDIR"/doc/*.8 "$SRCDIR"/*.8; do
	[[ -f "$src" ]] || continue
	base=$(basename "$src")
	sec="${base##*.}"
	install -Dvm644 "$src" "$PKGDIR/usr/share/man/man${sec}/${base}"
done
eval "$_shopt"
