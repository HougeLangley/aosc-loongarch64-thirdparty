#!/usr/bin/env bash
# zerotier-one 的实际构建与暂存（ABTYPE=self）

cd "$SRCDIR"

# Arch 方案：删掉 bundled miniupnpc，改用系统头/库，并打 miniupnpc 2.2.8 API 适配
rm -rf ext/miniupnpc
# 注意：不要在这里手动 patch——autobuild4 会自动应用 autobuild/patches/ 下的补丁，
# 手动再打一次会因「已应用」失败。此前脚本用的 $PKGDIR_SRC 在 autobuild4 里并不存在。

# Arch 的同类修法：upstream 的 Makefile/unit 用 /usr/sbin，本包安装到 /usr/bin。
# 先统一源码里的路径，避免 make install/unit 再引入 203/EXEC。
sed -i -e 's#/usr/sbin/zerotier-one#/usr/bin/zerotier-one#' \
    make-linux.mk debian/zerotier-one.service

# 构建路径泄露：二进制里嵌入了 /var/cache/acbs/build/... 路径。
# -ffile-prefix-map 把源码路径改写成稳定的 /usr/src，消除泄露且让构建可复现。
export CFLAGS="${CFLAGS:-} -ffile-prefix-map=$SRCDIR=/usr/src"
export CXXFLAGS="${CXXFLAGS:-} -ffile-prefix-map=$SRCDIR=/usr/src"
echo "[build] CXXFLAGS 已加 ffile-prefix-map"
echo "[build] 编译 ZeroTierOne ${PKGVER%-*}（$ABTHREADS 线程）"
make -j"${ABTHREADS:-$(nproc)}" -f make-linux.mk

echo "[build] 暂存到 $PKGDIR"
# 官方包的布局：真实二进制放在 /var/lib/zerotier-one/，/usr/bin 下是指向它的入口。
# 只装 /usr/bin 会触发对等检查「缺失 4 个官方文件」。
install -Dvm755 zerotier-one        "$PKGDIR/usr/bin/zerotier-one"
install -Dvm755 zerotier-one        "$PKGDIR/var/lib/zerotier-one/zerotier-one"
ln -sfv /var/lib/zerotier-one/zerotier-one "$PKGDIR/var/lib/zerotier-one/zerotier-cli"
ln -sfv /var/lib/zerotier-one/zerotier-one "$PKGDIR/var/lib/zerotier-one/zerotier-idtool"
# cli/idtool 是多调用（multi-call）入口，与上游 install 目标一致：用符号链接
ln -svf zerotier-one "$PKGDIR/usr/bin/zerotier-cli"
ln -svf zerotier-one "$PKGDIR/usr/bin/zerotier-idtool"

# 本包把二进制装在 /usr/bin，upstream unit 却指向 /usr/sbin；不修会 203/EXEC
install -d "$PKGDIR/usr/lib/systemd/system"
sed 's#^ExecStart=/usr/sbin/zerotier-one#ExecStart=/usr/bin/zerotier-one#' \
    debian/zerotier-one.service > "$PKGDIR/usr/lib/systemd/system/zerotier-one.service"
chmod 644 "$PKGDIR/usr/lib/systemd/system/zerotier-one.service"

install -d "$PKGDIR/usr/share/doc/zerotier-one"
install -vm644 LICENSE.txt "$PKGDIR/usr/share/doc/zerotier-one/"
# 官方包里有 usr/share/doc/zerotier-one/COPYING；上游源码里该文件叫 LICENSE-MPL.txt。
# 为了与官方布局一致，额外装一份同名的 COPYING。
for lic in COPYING LICENSE-MPL.txt LICENSE.txt; do
    if [[ -f "$lic" ]]; then
        install -vm644 "$lic" "$PKGDIR/usr/share/doc/zerotier-one/COPYING"
        break
    fi
done
# 官方包里有 usr/share/doc/zerotier-one/COPYING；上游源码里该文件叫 LICENSE-MPL.txt。
# 为了与官方布局一致，额外装一份同名的 COPYING。
for lic in COPYING LICENSE-MPL.txt LICENSE.txt; do
    if [[ -f "$lic" ]]; then
        install -vm644 "$lic" "$PKGDIR/usr/share/doc/zerotier-one/COPYING"
        break
    fi
done

install -d "$PKGDIR/usr/share/man/man1" "$PKGDIR/usr/share/man/man8"
gzip -9c doc/zerotier-cli.1  > "$PKGDIR/usr/share/man/man1/zerotier-cli.1.gz"
gzip -9c doc/zerotier-idtool.1 > "$PKGDIR/usr/share/man/man1/zerotier-idtool.1.gz"
gzip -9c doc/zerotier-one.8  > "$PKGDIR/usr/share/man/man8/zerotier-one.8.gz"
chmod 644 "$PKGDIR"/usr/share/man/man1/*.gz "$PKGDIR"/usr/share/man/man8/*.gz

install -d "$PKGDIR/var/lib/zerotier-one"
install -vm644 ext/installfiles/linux/zerotier-one.te "$PKGDIR/var/lib/zerotier-one/zerotier-one.te"

# 注意：不要在 $PKGDIR 下手工建 DEBIAN/ 放 postinst——
# autobuild4 的 75-qa-post-build.sh 会报 "QA (E321): found unexpected path(s)"。
# 服务启用交给包管理器/用户，或用 autobuild4 的正式钩子机制。

echo "[build] 暂存完成"
find "$PKGDIR" -type f | sed "s|$PKGDIR||" | sort
