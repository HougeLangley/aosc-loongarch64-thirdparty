PKGNAME=bandwhich
PKGSEC=net
PKGDES="Terminal bandwidth utilization tool showing per-process network usage"
PKGDEP="@AB_AUTO_SO_DEPS@"
BUILDDEP="rustc llvm"
PKGHOMEPAGE="https://github.com/imsnif/bandwhich"

ABTYPE=rust
USECLANG=1
NOCARGOAUDIT=1

# 官方 aosc-os-abbs 的 app-network/bandwhich 写着：
#   FAIL_ARCH="loongarch64"
#   USECLANG__LOONGARCH64=0
#   # FIXME: missing ld.lld support
# 并停在 0.23.0。本机实测（龙芯 3A6000，AOSC OS 14.0.1，rustc/llvm 22）：
# 用 USECLANG=1（即 ld.lld）编 0.23.1 全程通过，耗时 223s，
# 三闸门 selfcheck/parity/smoke 全绿 —— 官方那条 FIXME 对当前工具链已不成立。
# 因此本包是「解除了官方架构限制的更新版」，不是新增包。

# rustc 1.99.1 在 loongarch64 上做增量编译会 ICE（stable_hash_impls.rs 里 Option::unwrap 为 None）。
# 本包 2026-11-15 用同样参数成功过，说明是增量缓存触发的，不是代码问题。
export CARGO_INCREMENTAL=0
