PKGNAME=tectonic
PKGSEC=tex
PKGDES="A modernized, complete and self-contained TeX/LaTeX engine"
PKGDEP="@AB_AUTO_SO_DEPS@"
BUILDDEP="rustc llvm"
PKGHOMEPAGE="https://github.com/tectonic-typesetting/tectonic"

ABTYPE=rust
USECLANG=1
ABSPLITDBG=0
CARGO_AFTER="--features external-harfbuzz"

# 以下设置沿用官方 app-doc/tectonic 的定义。
# FIXME: Segfaults during linkage.  (官方原文，针对 loongson3)
NOLTO__LOONGSON3=1
NOLTO__LOONGARCH64=1

# ---- 与官方配方的唯一差异：移除了 FAIL_ARCH="loongarch64" ----
#
# 官方原注释（逐字）：
#   # FIXME: ld.lld is not yet available.
#   NOLTO__LOONGARCH64=1
#   FAIL_ARCH="loongarch64"
#
# 本机实测（龙芯 3A6000 / AOSC OS 14.0.1 / rustc+llvm 22 / 页面 16384）：
#   1. `cargo build --release --features external-harfbuzz` 全程通过，
#      耗时 5m09s，产出 22 MB 二进制，退出码 0；
#   2. `tectonic --version` 输出 `Tectonic 0.17.0`；
#   3. 端到端排版验证：对一份含公式的 article 执行
#      `tectonic -X compile a.tex`，成功写出 7027 字节的 a.pdf（头部 %PDF-1.5）。
#
# 结论：`ld.lld is not yet available` 在当前工具链上已不成立 ——
# 本机的 bandwhich 也是用 USECLANG=1（即 ld.lld）编过的。
# 因此本包是「解除了官方过期架构限制的更新版」，不是新增包。
