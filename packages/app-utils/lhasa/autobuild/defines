PKGNAME=lhasa
PKGSEC=utils
PKGDES="Freely licensed LHA/LZH archive tool and library"
PKGDEP="@AB_AUTO_SO_DEPS@"
BUILDDEP=""
PKGHOMEPAGE="https://github.com/fragglet/lhasa"

ABTYPE=self
# 上游 git 仓库不附带生成的 configure，只有 configure.ac + autogen.sh。
# 关键：lhasa 的 autogen.sh 是 `autoreconf -fi && ./configure "$@"`，
# **无条件**跑 configure 且不认 NOCONFIGURE，所以不能交给 autotools 模板
# （模板会 NOCONFIGURE=1 调 autogen 再自己 configure，导致
#  "source directory already configured"）。这里用 self 让 autogen 一次到位。
