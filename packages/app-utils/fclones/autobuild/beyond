# Rust workspace 走的是模板的 fallback 分支（cargo build --workspace 后把
# target/release 下所有可执行文件都装进 /usr/bin），会把 workspace 里的
# 测试辅助程序一起带进来。上游 `cargo install --path .` 只装 fclones 本体，
# AOSC 规范也要求不打包测试代码，因此在打包后清理。
abinfo "Removing test-only binaries ..."
for b in gen-test-files; do
	if [[ -e "$PKGDIR/usr/bin/$b" ]]; then
		rm -fv "$PKGDIR/usr/bin/$b"
	fi
done
