PKGNAME=git
PKGSEC=vcs
PKGDES="Fast distributed version control system"
PKGDEP="curl expat openssl pcre2 perl perl-error cvsps perl-authen-sasl \
        libwww-perl perl-mime-tools perl-net-smtp-ssl perl-term-readkey \
        python-3 tk perl-dbi subversion brotli"
PKGRECOM="git-lfs gitk git-gui"
BUILDDEP="xmlto emacs libsecret asciidoc rustc"

ABTYPE=meson
MESON_AFTER="-Dcontrib=completion,contacts,subtree -Ddocs=man -Ddefault_editor=/usr/bin/editor -Dcredential_helpers=libsecret -Dgitk=disabled -Dgit_gui=disabled"

# Upstream AOSC disables LTO after libgitcore.a linker failures.
NOLTO=1

# LoongArch64 is a mainline architecture.
FAIL_ARCH="!(mainline|retro)"
